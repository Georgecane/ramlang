extern fn ramlang_last_error() -> str;
extern fn ramlang_tcp_connect(address: str, timeout_ms: u64) -> ptr;
extern fn ramlang_tcp_write_frame(connection: ptr, data: ptr, length: u64) -> i64;
extern fn ramlang_tcp_read_frame(connection: ptr, output: ptr, capacity: u64) -> i64;
extern fn ramlang_tcp_close(connection: ptr);

fn main() -> i32 {
    let connection: ptr = ramlang_tcp_connect("127.0.0.1:39871", 2000);
    if (connection == null) {
        print(ramlang_last_error());
        return 1;
    }

    let write_result: i64 = ramlang_tcp_write_frame(connection, "ping" as ptr, 4);
    if (write_result < 0) {
        print(ramlang_last_error());
        ramlang_tcp_close(connection);
        return 2;
    }

    let buffer: ptr = alloc(128);
    let received: i64 = ramlang_tcp_read_frame(connection, buffer, 128);
    if (received < 0) {
        print(ramlang_last_error());
        free(buffer);
        ramlang_tcp_close(connection);
        return 3;
    }

    print(received);
    print(load_u8(buffer));
    free(buffer);
    ramlang_tcp_close(connection);
    return 0;
}
