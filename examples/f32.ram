const HALF: f32 = 0.5;
const TINY: f32 = 1.25e-2;

fn main() -> i32 {
    let values: [f32; 2] = [1.5, 2.25];
    let result: f32 = values[0] * values[1] + HALF;
    print(result);

    let wide: f64 = result as f64;
    let narrow: f32 = wide as f32;
    print(narrow);

    // Narrowing and printing stay inside the native RamLang runtime.
    print(narrow);

    let integer: i32 = narrow as i32;
    print(integer);
    print(size_of([f32; 2]));
    print(align_of(f32));
    print(TINY);
    return 0;
}
