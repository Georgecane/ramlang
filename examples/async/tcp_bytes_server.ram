fn main() -> i32 {
    let listener_future: Future<ptr> = tcp_listen("127.0.0.1:0", 5000);
    let listener: ptr = await listener_future;
    if (listener == null) {
        print(last_error());
        return 1;
    }

    let address: str = tcp_listener_addr(listener);
    if (address == null) {
        print(last_error());
        tcp_listener_close(listener);
        return 2;
    }

    let payload: ptr = alloc(5);
    store_u8(payload, 0);
    store_u8(ptr_offset(payload, 1), 255);
    store_u8(ptr_offset(payload, 2), 128);
    store_u8(ptr_offset(payload, 3), 65);
    store_u8(ptr_offset(payload, 4), 10);

    let client_future: Future<ptr> = tcp_request_bytes(address, payload, 5, 5000);
    let accept_future: Future<ptr> = tcp_accept(listener);
    let connection: ptr = await accept_future;
    if (connection == null) {
        print(last_error());
        free(payload);
        free(address as ptr);
        tcp_listener_close(listener);
        return 3;
    }

    let incoming: ptr = await tcp_read_bytes(connection);
    if (incoming == null) {
        print(last_error());
        free(payload);
        free(address as ptr);
        tcp_close(connection);
        tcp_listener_close(listener);
        return 4;
    }

    let incoming_length: i64 = buffer_len(incoming);
    let incoming_data: ptr = buffer_data(incoming);
    let write_future: Future<void> = tcp_write_bytes(connection, incoming_data, incoming_length);
    await write_future;

    let response: ptr = await client_future;
    if (response == null) {
        print(last_error());
        buffer_close(incoming);
        free(payload);
        free(address as ptr);
        tcp_close(connection);
        tcp_listener_close(listener);
        return 5;
    }

    let response_length: i64 = buffer_len(response);
    let response_data: ptr = buffer_data(response);
    print(response_length);
    print(load_u8(response_data));
    print(load_u8(ptr_offset(response_data, 1)));
    print(load_u8(ptr_offset(response_data, 2)));
    print(load_u8(ptr_offset(response_data, 3)));
    print(load_u8(ptr_offset(response_data, 4)));

    buffer_close(response);
    buffer_close(incoming);
    free(payload);
    free(address as ptr);
    tcp_close(connection);
    tcp_listener_close(listener);
    return 0;
}
